NODE_ENV=test
PORT=3000
# Cada entorno usa su propia base de datos (RNF-22).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/codimac_test?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:8443
DATABASE_SSL=true
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
DEMO_RESET_ENABLED=false
# Base aislada para la prueba de inmutabilidad de auditoría.
AUDIT_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/codimac_test?sslmode=require
