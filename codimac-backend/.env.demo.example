NODE_ENV=production
PORT=3000
# Cada entorno usa su propia base de datos (RNF-22).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/codimac_demo?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=https://demo.codimac.example
DATABASE_SSL=true
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
DEMO_RESET_ENABLED=true
FORCE_HTTPS=true
